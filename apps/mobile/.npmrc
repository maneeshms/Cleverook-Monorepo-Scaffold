# The Clevrook Design Kit (@clevrook/tokens · theme · icons · native) is published
# to GitHub Packages, not the public registry. Only the @clevrook scope is
# redirected — every other dependency still resolves from registry.npmjs.org.
#
# ── The token does NOT go in this file ──────────────────────────────────────
# pnpm refuses to expand environment variables in registry credentials that come
# from a project .npmrc, because that file is committed and a rewritten registry
# line could ship your token to an attacker-controlled host. A `${GITHUB_TOKEN}`
# placeholder here is silently IGNORED and the install 401s.
#
# Configure the credential once, in your USER-level config (~/.npmrc):
#   pnpm config set "//npm.pkg.github.com/:_authToken" ghp_your_token
#
# The token needs `read:packages`; SSO orgs must also authorize it for `clevrook`.
# `pnpm run doctor` checks this. CI and Docker inject it at build time — see
# docs/DESIGN_SYSTEM.md.
#
# This file is deliberately NOT rescoped by scripts/init.mjs — @clevrook here
# names the real published scope, not this project's libs.
@clevrook:registry=https://npm.pkg.github.com

# Exact pins for everything except the Expo-managed packages (expo-*,
# react-native), which keep the SDK's `~` ranges — bump those with `npx expo install`.
save-exact=true

# ── Flat node_modules, required for React Native ────────────────────────────
# Metro (the RN bundler) does not follow pnpm's default symlinked layout: it
# resolves modules by walking node_modules directories on disk, so a symlinked
# store produces "Unable to resolve module" failures at bundle time.
#
# This is the ONLY package in the repo that opts out of pnpm's isolated layout —
# the backend and both web apps keep the strict default, which is what caught the
# undeclared `bcryptjs` import during the npm→pnpm migration. Do not copy this
# line into other apps.
node-linker=hoisted
