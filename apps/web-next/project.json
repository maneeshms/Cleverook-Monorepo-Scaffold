{
  "name": "web-next",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-next/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "[ -d node_modules ] || pnpm install --frozen-lockfile; pnpm run dev",
        "cwd": "apps/web-next"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "[ -d node_modules ] || pnpm install --frozen-lockfile; NODE_ENV=production pnpm run build",
        "cwd": "apps/web-next"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "[ -d node_modules ] || pnpm install --frozen-lockfile; pnpm run lint",
        "cwd": "apps/web-next"
      }
    }
  },
  "tags": ["scope:web-next", "type:app"]
}
