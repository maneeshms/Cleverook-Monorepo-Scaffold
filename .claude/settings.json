{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run:*)",
      "Bash(pnpm exec nx:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(docker:*)"],
    "deny": ["Read(./.env)", "Read(./**/.env)", "Read(./**/*.pem)"]
  }
}
